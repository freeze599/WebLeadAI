@model WebLeadAI.Models.Lead
@using WebLeadAI.Services

@{
    ViewData["Title"] = "Projekta detaļas";
    string displayTitle = LeadContentText.ToPlainText(Model.CompanyName);
    string displayDescription = LeadContentText.ToPlainText(Model.Description);

    bool frenchSource = Uri.TryCreate(Model.SourceUrl, UriKind.Absolute, out var proposalUri)
        && (proposalUri.Host.Equals("codeur.com", StringComparison.OrdinalIgnoreCase)
            || proposalUri.Host.EndsWith(".codeur.com", StringComparison.OrdinalIgnoreCase));
    string proposalLanguage = Model.ProposalLanguage is "lv" or "en" or "fr"
        ? Model.ProposalLanguage : (frenchSource ? "fr" : "en");
    string proposalDraft = Model.ProposalDraft ?? LeadProposalService.Build(Model.CompanyName, proposalLanguage);

    string statusColor = Model.Status switch
    {
        "Qualified" => "success",
        "Contacted" => "primary",
        "Rejected" => "danger",
        "NeedsReview" => "warning",
        _ => "secondary"
    };

    bool validSource = Uri.TryCreate(
        Model.SourceUrl,
        UriKind.Absolute,
        out var sourceUri)
        && (sourceUri.Scheme == Uri.UriSchemeHttps
            || sourceUri.Scheme == Uri.UriSchemeHttp);
}

<div class="container py-4">

    <div class="d-flex justify-content-between
        align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Projekta detaļas</h2>
            <p class="text-muted mb-0">
                WebLeadAI — klienta izvērtēšana
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Atpakaļ
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">

            <h3 class="mb-3">
                @displayTitle
            </h3>

            <div class="mb-3">
                <span class="badge bg-@statusColor">
                    @Model.Status
                </span>

                <span class="badge bg-secondary ms-2">
                    Vērtējums: @Model.AILeadScore / 100
                </span>
            </div>

            <hr />

            <h5>Projekta apraksts</h5>

            <div class="border rounded p-3 bg-light mb-4"
                 style="white-space:pre-wrap; overflow-wrap:anywhere;">@(string.IsNullOrWhiteSpace(displayDescription) ? "Apraksts nav norādīts." : displayDescription)</div>

            <h5>Informācija</h5>

            <dl class="row mt-3">
                <dt class="col-sm-3">Avota tips</dt>
                <dd class="col-sm-9">
                    @Model.SourceType
                </dd>

                <dt class="col-sm-3">Mājaslapa</dt>
                <dd class="col-sm-9">
                    @(Model.Website ?? "Nav norādīta")
                </dd>

                <dt class="col-sm-3">E-pasts</dt>
                <dd class="col-sm-9">
                    @(Model.Email ?? "Nav norādīts")
                </dd>

                <dt class="col-sm-3">Reģistrētā uzrunāšana</dt>
                <dd class="col-sm-9">
                    @(Model.LastContactedAt.HasValue
                        ? Model.LastContactedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        : "Vēl nav reģistrēta")
                </dd>

                <dt class="col-sm-3">Pievienots</dt>
                <dd class="col-sm-9">
                    @(Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                </dd>
            </dl>

            @if (validSource)
            {
                <a href="@Model.SourceUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline-primary mt-2">
                    Atvērt oriģinālo sludinājumu ↗
                </a>
            }

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h5 class="mb-3">Projekta izvērtēšana</h5>
            <div class="border rounded p-3 mb-3">
                <p class="small text-muted mb-2">
                    Pēc pieteikuma nosūtīšanas oriģinālajā platformā vai e-pastā
                    atzīmē projektu kā uzrunātu. Šī poga neko nenosūta.
                    Ja uzrunāšanas datums jau reģistrēts, tas saglabājas.
                </p>
                @if (Model.Status == "Contacted" && Model.LastContactedAt.HasValue)
                {
                    <span class="badge bg-primary">Uzrunāts</span>
                }
                else
                {
                    <form asp-action="MarkContacted" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary">Atzīmēt kā uzrunātu</button>
                    </form>
                }
            </div>


            <div class="d-flex gap-2 flex-wrap">

                <form asp-action="UpdateStatus"
                      method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="status"
                           value="Qualified" />

                    <button type="submit"
                            class="btn btn-success">
                        ✓ Apstiprināt
                    </button>
                </form>

                <form asp-action="UpdateStatus"
                      method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="status"
                           value="Rejected" />

                    <button type="submit"
                            class="btn btn-danger">
                        ✕ Noraidīt
                    </button>
                </form>

                <form asp-action="UpdateStatus"
                      method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="status"
                           value="NeedsReview" />

                    <button type="submit"
                            class="btn btn-outline-secondary">
                        ↺ Atgriezt pārskatīšanā
                    </button>
                </form>

            </div>

        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body p-4">
            <h5>Pieteikuma melnraksts</h5>
            <p class="text-muted small">
                Veidnes teksts ar projekta nosaukumu. Pirms nosūtīšanas pielāgo to pilnajām
                prasībām, aizpildi laukus kvadrātiekavās un izņem jau atbildētos jautājumus.
                Izmaiņas saglabā ar pogu “Saglabāt melnrakstu”. Katram projektam glabājas viens melnraksts.
                Kopēšana neko nenosūta un nemaina projekta statusu.
            </p>
            <p id="proposalSavedAt" class="small text-muted">
                @(Model.ProposalSavedAt.HasValue
                    ? "Pēdējoreiz saglabāts: " + Model.ProposalSavedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    : "Melnraksts vēl nav saglabāts.")
            </p>
            <form id="proposalForm" asp-action="SaveProposal" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="d-flex gap-2 align-items-end flex-wrap mb-3">
                <div>
                    <label for="proposalLanguage" class="form-label">Melnraksta valoda</label>
                    <select id="proposalLanguage" name="proposalLanguage" class="form-select">
                        <option value="lv" selected="@(proposalLanguage == "lv")">Latviešu</option>
                        <option value="en" selected="@(proposalLanguage == "en")">English</option>
                        <option value="fr" selected="@(proposalLanguage == "fr")">Français</option>
                    </select>
                </div>
                <button id="restoreProposal" type="button" class="btn btn-outline-secondary">
                    Atjaunot veidni
                </button>
            </div>
            <label for="proposalDraft" class="form-label">Rediģē pieteikuma tekstu</label>
            <textarea id="proposalDraft" name="proposalDraft" class="form-control" rows="18" maxlength="20000" required>@proposalDraft</textarea>
            <div class="d-flex gap-3 align-items-center flex-wrap mt-3">
                <button id="saveProposal" type="submit" class="btn btn-success">Saglabāt melnrakstu</button>
                <button id="copyProposal" type="button" class="btn btn-primary">
                    Kopēt pieteikumu
                </button>
                <span id="proposalMessage" class="small" role="status" aria-live="polite"></span>
            </div>
            </form>
            <textarea id="proposalTemplate-lv" hidden>@LeadProposalService.Build(Model.CompanyName, "lv")</textarea>
            <textarea id="proposalTemplate-en" hidden>@LeadProposalService.Build(Model.CompanyName, "en")</textarea>
            <textarea id="proposalTemplate-fr" hidden>@LeadProposalService.Build(Model.CompanyName, "fr")</textarea>
        </div>
    </div>

</div>


@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const editor = document.getElementById("proposalDraft");
    const language = document.getElementById("proposalLanguage");
    const message = document.getElementById("proposalMessage");
    let currentLanguage = language.value;
    let baseline = editor.value;
    let baselineLanguage = language.value;
    const form = document.getElementById("proposalForm");
    const saveButton = document.getElementById("saveProposal");

    function restoreTemplate() {
        if (editor.value !== document.getElementById("proposalTemplate-" + currentLanguage).value &&
            !window.confirm("Aizvietot tavas izmaiņas ar izvēlētās valodas veidni?")) {
            language.value = currentLanguage;
            return;
        }
        currentLanguage = language.value;
        editor.value = document.getElementById("proposalTemplate-" + currentLanguage).value;
        message.textContent = "Veidne atjaunota. Izmaiņas vēl nav saglabātas.";
    }

    language.addEventListener("change", restoreTemplate);
    document.getElementById("restoreProposal").addEventListener("click", restoreTemplate);
    editor.addEventListener("input", function () { message.textContent = ""; });
    document.getElementById("copyProposal").addEventListener("click", async function () {
        if (!editor.value.trim()) {
            message.textContent = "Ievadi pieteikuma tekstu.";
            return;
        }
        try {
            if (!navigator.clipboard || !navigator.clipboard.writeText) throw new Error("Clipboard unavailable");
            await navigator.clipboard.writeText(editor.value);
            message.textContent = "Pieteikums nokopēts. Pirms nosūtīšanas pārbaudi tekstu.";
        } catch {
            editor.focus();
            editor.select();
            message.textContent = "Automātiska kopēšana nav pieejama. Teksts atlasīts — nospied Ctrl+C (Mac: Cmd+C).";
        }
    });
    form.addEventListener("submit", async function (event) {
        event.preventDefault();
        if (saveButton.disabled) return;
        if (!editor.value.trim()) {
            message.textContent = "Ievadi pieteikuma tekstu.";
            return;
        }
        const submittedText = editor.value;
        const submittedLanguage = language.value;
        const data = new FormData(form);
        saveButton.disabled = true;
        message.textContent = "Saglabā...";
        try {
            const response = await fetch(form.action, {
                method: "POST", body: data, credentials: "same-origin"
            });
            const result = await response.json().catch(() => null);
            if (!response.ok || !result || !result.savedAt)
                throw new Error(result?.message || "Neizdevās saglabāt. Teksts paliek redaktorā; pārbaudi, vai lietotne darbojas, un mēģini vēlreiz.");
            baseline = submittedText;
            baselineLanguage = submittedLanguage;
            document.getElementById("proposalSavedAt").textContent =
                "Pēdējoreiz saglabāts: " + new Date(result.savedAt).toLocaleString("lv-LV");
            message.textContent = editor.value === baseline && language.value === baselineLanguage
                ? "Melnraksts saglabāts."
                : "Iepriekšējā versija saglabāta; jaunākās izmaiņas vēl jāsaglabā.";
        } catch (error) {
            message.textContent = error instanceof TypeError
                ? "Nav savienojuma. Teksts paliek redaktorā; pēc savienojuma atjaunošanas saglabā vēlreiz."
                : error.message;
        } finally {
            saveButton.disabled = false;
        }
    });
    window.addEventListener("beforeunload", function (event) {
        if (editor.value !== baseline || language.value !== baselineLanguage) {
            event.preventDefault();
            event.returnValue = "";
        }
    });
});
</script>
}
