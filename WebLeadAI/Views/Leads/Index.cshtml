@model IEnumerable<WebLeadAI.Models.Lead>
@using WebLeadAI.Services

@{
    ViewData["Title"] = "Potenciālie klienti";

    var leads = Model.ToList();
    var qualificationService = new LeadQualificationService();

    string search = ViewBag.Search ?? "";
    string status = ViewBag.Status ?? "";
    string source = ViewBag.Source ?? "";
    string sort = ViewBag.Sort ?? "score";
    string age = ViewBag.Age ?? "";

    var sources = ViewBag.Sources as List<string>
        ?? new List<string>();
}

<div class="container py-4">

    <div class="d-flex justify-content-between
        align-items-start mb-4">
        <div>
            <div>
                <h2 class="fw-bold">
                    WebLeadAI — Potenciālie klienti
                </h2>

                <p class="text-muted">
                    Starptautisko projektu meklēšana un atlase
                </p>
            </div>
        </div>

        <span class="badge bg-primary fs-6">
            Kopā: @ViewBag.TotalCount
        </span>
    </div>

    <div class="d-flex gap-2 mb-4 flex-wrap">

        <a asp-action="Create"
           class="btn btn-primary">
            + Pievienot klientu
        </a>

        <form asp-action="Discover" method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-success">
                🔎 Meklēt jaunus klientus
            </button>
        </form>

        <form asp-action="RecalculateScores" method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-primary">
                ↻ Pārvērtēt projektus
            </button>
        </form>

        <a asp-action="QualificationAudit"
           class="btn btn-outline-secondary">
            Vērtēšanas audits
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.DiscoveryStatistics is List<LeadSourceStatistics> stats)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Pēdējās meklēšanas statistika</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Avots</th>
                            <th>Nolasīti</th>
                            <th>Atbilstoši</th>
                            <th>Dublikāti</th>
                            <th>Neatbilstoši jauni</th>
                            <th>Pievienoti</th>
                            <th>Rezultāts</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in stats)
                        {
                            <tr>
                                <td><strong>@stat.Source</strong></td>
                                <td>@stat.Read</td>
                                <td>@stat.Qualified</td>
                                <td>@stat.Duplicates</td>
                                <td>@stat.Rejected</td>
                                <td><strong class="text-success">@stat.Added</strong></td>
                                <td>
                                    @if (stat.Error != null)
                                    {
                                        <span class="badge bg-danger" title="@stat.Error">Kļūda</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">OK</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>Kopā</td>
                            <td>@stats.Sum(x => x.Read)</td>
                            <td>@stats.Sum(x => x.Qualified)</td>
                            <td>@stats.Sum(x => x.Duplicates)</td>
                            <td>@stats.Sum(x => x.Rejected)</td>
                            <td>@stats.Sum(x => x.Added)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="card-footer text-muted small">
                “Atbilstoši” ietver arī jau zināmus projektus. “Dublikāti” ietver visus jau saglabātos URL neatkarīgi no vērtējuma.
                Statistika attiecas uz pēdējo meklēšanu šajā pārlūka sesijā.
            </div>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="text-muted">Visi ieraksti</div>
                    <h3>@ViewBag.TotalCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="text-muted">Jāpārskata</div>
                    <h3>@ViewBag.ReviewCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="text-muted">Apstiprināti</div>
                    <h3 class="text-success">
                        @ViewBag.QualifiedCount
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="text-muted">Noraidīti</div>
                    <h3 class="text-danger">
                        @ViewBag.RejectedCount
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="mb-3">Projektu filtrēšana</h5>

            <form method="get"
                  asp-action="Index"
                  class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label">Meklēt</label>

                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="ASP.NET, website, redesign..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Statuss</label>

                    <select name="status" class="form-select">
                        <option value="">Visi statusi</option>
                        <option value="New" selected="@(status == "New")">New</option>
                        <option value="NeedsReview" selected="@(status == "NeedsReview")">NeedsReview</option>
                        <option value="Qualified" selected="@(status == "Qualified")">Qualified</option>
                        <option value="Rejected" selected="@(status == "Rejected")">Rejected</option>
                        <option value="Contacted" selected="@(status == "Contacted")">Uzrunāti (Contacted)</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Avots</label>

                    <select name="source" class="form-select">
                        <option value="">Visi avoti</option>

                        @foreach (var item in sources)
                        {
                            <option value="@item"
                                    selected="@(source == item)">
                                @item
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Publicēts</label>

                    <select name="age" class="form-select">
                        <option value="">Jebkurā laikā</option>
                        <option value="7" selected="@(age == "7")">
                            Pēdējās 7 dienās
                        </option>
                        <option value="30" selected="@(age == "30")">
                            Pēdējās 30 dienās
                        </option>
                        <option value="unknown" selected="@(age == "unknown")">
                            Datums nav zināms
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Kārtošana</label>

                    <select name="sort" class="form-select">
                        <option value="score" selected="@(sort == "score")">
                            Augstākā prioritāte
                        </option>
                        <option value="score_asc" selected="@(sort == "score_asc")">
                            Zemākā prioritāte
                        </option>
                        <option value="newest" selected="@(sort == "newest")">
                            Jaunākie pievienotie
                        </option>
                        <option value="oldest" selected="@(sort == "oldest")">
                            Vecākie pievienotie
                        </option>
                        <option value="published" selected="@(sort == "published")">
                            Jaunākie publicētie
                        </option>
                    </select>
                </div>

                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button type="submit"
                            class="btn btn-primary">
                        Filtrēt
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Notīrīt
                    </a>

                    <a asp-controller="Leads"
                       asp-action="TestQualification"
                       class="btn btn-outline-dark">
                        🧪 Testēt vērtēšanu
                    </a>

                </div>

            </form>
        </div>
    </div>

    <div class="alert alert-light border">
        <strong>Kā lasīt vērtējumus:</strong>
        Pasūtījuma ticamība rāda klienta pieprasījuma pazīmes,
        prasmju atbilstība — projekta saistību ar tavām tehnoloģijām.
        Tie ir algoritmiski punkti, nevis varbūtības.
        <div class="small text-muted mt-1">
            Prioritāte ir datubāzē saglabātais vērtējums, pēc kura kārto sarakstu.
            Pasūtījuma un prasmju rādītāji tiek aprēķināti ar algoritmu 2.3.
            Ja prioritāte atšķiras no pašreizējā aprēķina, nospied “Pārvērtēt projektus”.
            Statuss rāda saglabāto izvērtēšanas lēmumu.
        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white py-3
            d-flex justify-content-between">
            <h5 class="mb-0">Projektu saraksts</h5>

            <span class="text-muted">
                Atrasti: @leads.Count
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-striped
                table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Projekts</th>
                        <th>Avots</th>
                        <th>Pasūtījuma ticamība</th>
                        <th>Prasmju atbilstība</th>
                        <th>Prioritāte</th>
                        <th>Publicēts</th>
                        <th>Statuss</th>
                        <th>Darbības</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var lead in leads)
                    {
                        var evaluation = qualificationService.EvaluateV2(
                            lead.CompanyName ?? "", lead.Description ?? "");

                        string color = lead.Status switch
                        {
                            "Qualified" => "success",
                            "Contacted" => "primary",
                            "Rejected" => "danger",
                            "NeedsReview" => "warning",
                            _ => "secondary"
                        };

                        string host = "Manual";

                        if (Uri.TryCreate(
                            lead.SourceUrl,
                            UriKind.Absolute,
                            out var uri))
                        {
                            host = uri.Host.Replace("www.", "");
                        }

                        <tr>
                            <td style="max-width:400px;
                                overflow-wrap:anywhere;">
                                <strong>
                                    @System.Net.WebUtility.HtmlDecode(
                                        lead.CompanyName)
                                </strong>
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @host
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @evaluation.OrderConfidence / 100
                                </span>
                                <details class="small text-muted mt-1">
                                    <summary>Pamatojums</summary>
                                    <div class="mt-1" style="min-width:160px; overflow-wrap:anywhere;">
                                        @evaluation.OrderReason
                                    </div>
                                </details>
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @evaluation.SkillMatch / 100
                                </span>
                                <details class="small text-muted mt-1">
                                    <summary>Pamatojums</summary>
                                    <div class="mt-1" style="min-width:160px; overflow-wrap:anywhere;">
                                        @evaluation.SkillReason
                                    </div>
                                </details>
                            </td>

                            <td>
                                <strong class="text-nowrap">@lead.AILeadScore / 100</strong>
                                @if (lead.AILeadScore != evaluation.Score)
                                {
                                    <div class="small text-warning-emphasis mt-1">
                                        Jāpārvērtē: jaunais @evaluation.Score / 100
                                    </div>
                                }
                            </td>


                            <td>
                                @if (lead.PublishedAt.HasValue)
                                {
                                    @(lead.PublishedAt.Value.ToLocalTime().ToString("dd.MM.yyyy"))
                                }
                                else
                                {
                                    <span class="text-muted">Nav zināms</span>
                                }
                            </td>


                            <td>
                                <span class="badge bg-@color">
                                    @(lead.Status == "Contacted" ? "Uzrunāts" : lead.Status)
                                </span>
                                @if (lead.LastContactedAt.HasValue)
                                {
                                    <div class="small text-muted mt-1" title="Reģistrētā uzrunāšana">
                                        @(lead.LastContactedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                    </div>
                                }
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@lead.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Apskatīt →
                                </a>
                            </td>
                        </tr>
                    }

                    @if (!leads.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted py-4">
                                Nav projektu, kas atbilst filtriem.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
