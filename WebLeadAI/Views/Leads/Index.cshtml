@model IEnumerable<WebLeadAI.Models.Lead>

@{
    ViewData["Title"] = "Potenciālie klienti";
    var leads = Model.ToList();
}

<div class="container py-4">

    <div class="d-flex justify-content-between
        align-items-start mb-4">
        <div>
            <h2 class="fw-bold">
                WebLeadAI — Potenciālie klienti
            </h2>

            <p class="text-muted">
                Atrastie mājaslapu izstrādes pasūtījumi
            </p>
        </div>

        <span class="badge bg-primary fs-6">
            Kopā: @leads.Count
        </span>
    </div>

    <div class="d-flex gap-2 mb-4 flex-wrap">

        <a asp-action="Create"
           class="btn btn-primary">
            + Pievienot klientu
        </a>

        <form asp-action="Discover" method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-success">
                🔎 Meklēt jaunus klientus
            </button>
        </form>

        <form asp-action="RecalculateScores" method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-primary">
                ↻ Pārvērtēt projektus
            </button>
        </form>


    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 bg-light">
                <div class="card-body">
                    <div class="text-muted">
                        Visi ieraksti
                    </div>
                    <h3>@leads.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 bg-light">
                <div class="card-body">
                    <div class="text-muted">
                        Jāpārskata
                    </div>
                    <h3>
                        @leads.Count(l =>
                            l.Status == "NeedsReview"
                            || l.Status == "New")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 bg-light">
                <div class="card-body">
                    <div class="text-muted">
                        Apstiprināti
                    </div>
                    <h3 class="text-success">
                        @leads.Count(l =>
                            l.Status == "Qualified")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 bg-light">
                <div class="card-body">
                    <div class="text-muted">
                        Noraidīti
                    </div>
                    <h3 class="text-danger">
                        @leads.Count(l =>
                            l.Status == "Rejected")
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Projektu saraksts</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-striped
                table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Projekts</th>
                        <th>Avots</th>
                        <th>Vērtējums</th>
                        <th>Statuss</th>
                        <th>Darbības</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var lead in leads)
                    {
                        string color = lead.Status switch
                        {
                            "Qualified" => "success",
                            "Rejected" => "danger",
                            "NeedsReview" => "warning",
                            _ => "secondary"
                        };

                        <tr>
                            <td style="max-width:400px;
                                overflow-wrap:anywhere;">
                                <strong>
                                    @System.Net.WebUtility.HtmlDecode(
                                        lead.CompanyName)
                                </strong>
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @lead.SourceType
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @lead.AILeadScore / 100
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-@color">
                                    @lead.Status
                                </span>
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@lead.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Apskatīt →
                                </a>
                            </td>
                        </tr>
                    }

                    @if (!leads.Any())
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-4">
                                Pagaidām nav atrastu projektu.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>
