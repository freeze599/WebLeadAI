@model IEnumerable<WebLeadAI.Models.Lead>
@using WebLeadAI.Services

@{
    ViewData["Title"] = "Potenciālie klienti";

    var leads = Model.ToList();
    var qualificationService = new LeadQualificationService();

    string search = ViewBag.Search ?? "";
    string status = ViewBag.Status ?? "";
    string source = ViewBag.Source ?? "";
    string sort = ViewBag.Sort ?? "score";
    string age = ViewBag.Age ?? "";
    string budget = ViewBag.Budget ?? "";
    string deadline = ViewBag.Deadline ?? "";
    string soloFit = ViewBag.SoloFit ?? "";
    string actionable = ViewBag.Actionable ?? "";
    string access = ViewBag.Access ?? "free";
    string kind = ViewBag.Kind ?? "";

    var sources = ViewBag.Sources as List<string>
        ?? new List<string>();
}

<div class="container py-4">

    <div class="d-flex justify-content-between
        align-items-start mb-4">
        <div>
            <div>
                <h2 class="fw-bold">
                    WebLeadAI — Potenciālie klienti
                </h2>

                <p class="text-muted">
                    Starptautisko projektu meklēšana un atlase
                </p>
            </div>
        </div>

        <span class="badge bg-primary fs-6">
            Datubāzē: @ViewBag.TotalCount
        </span>
    </div>

    <div class="d-flex gap-2 mb-4 flex-wrap">

        <a asp-action="Create"
           class="btn btn-primary">
            + Pievienot klientu
        </a>

        <form asp-action="Discover" method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-success">
                🔎 Meklēt jaunus klientus
            </button>
        </form>

        <form asp-action="RecalculateScores" method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-primary">
                ↻ Pārvērtēt projektus
            </button>
        </form>

        <a asp-action="Sources" class="btn btn-outline-primary">Meklēšanas avoti</a>
        <a asp-action="JobicyDiagnostics" class="btn btn-outline-secondary">Jobicy atlases diagnostika</a>
        <a asp-action="QualificationAudit"
           class="btn btn-outline-secondary">
            Vērtēšanas audits
        </a>
        <a asp-action="RecommendationDiagnostics"
           class="btn btn-outline-secondary">
            Ieteikumu diagnostika
        </a>
    </div>

    <div class="alert alert-info">
        Automātiskā meklēšana: <strong>SS.com, IUB, Jobicy un Freelancehunt</strong>. SS.com rezultāti tiek atkārtoti izmantoti 30 minūtes;
        pārbauda līdz 20 jaunākajiem programmētāju sludinājumiem. Jobicy meklē līgumdarbus/nepilnu slodzi (līdz 500 inženierijas piedāvājumiem, 30 minūšu kešatmiņa). Hubstaff, Truelancer un Ukrainas avoti pieejami
        sadaļā <a asp-action="Sources">Meklēšanas avoti</a> manuālai pārbaudei.
        Freelancehunt nepieciešama lokālā API atslēga; atradumi sākumā redzami skatā <a asp-action="Index" asp-route-access="unknown" asp-route-source="freelancehunt.com">Piekļuve jāpārbauda — Freelancehunt</a>. Maksas platformu vecie ieraksti saglabāti atsevišķā skatā; noklusējuma sarakstā tie netiek rādīti.
    </div>
    @{
        var auto = ((DateTime? LastRunUtc, int Added, string? Message))ViewBag.AutoDiscovery;
    }
    <div class="small text-muted mb-3" role="status">
        <strong>Freelancehunt automātiskā meklēšana:</strong>
        ik pēc 10 minūtēm (kamēr programma darbojas).
        @if (auto.LastRunUtc.HasValue)
        {
            <span>Pēdējā pārbaude (UTC): @auto.LastRunUtc.Value.ToString("yyyy-MM-dd HH:mm"); jauni: @auto.Added.</span>
            @if (!string.IsNullOrEmpty(auto.Message))
            {
                <span> Piezīme: @auto.Message</span>
            }
        }
        else
        {
            <span>Pirmā pārbaude pēc programmas palaišanas.</span>
        }
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.DiscoveryStatistics is List<LeadSourceStatistics> stats)
    {
        <p class="small text-muted">Līgumdarbu dati: <a href="https://jobicy.com" target="_blank" rel="noopener noreferrer">Jobicy</a>. Konkrētā darba nosacījumi jāpārbauda oriģinālajā sludinājumā.</p>
    <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Pēdējās meklēšanas statistika</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Avots</th>
                            <th>Nolasīti</th>
                            <th>Atbilstoši</th>
                            <th>Dublikāti</th>
                            <th>Neatbilstoši jauni</th>
                            <th>Pievienoti</th>
                            <th>Rezultāts</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in stats)
                        {
                            <tr>
                                <td><strong>@stat.Source</strong>@if (stat.Source == "Jobicy") { <a asp-action="JobicyDiagnostics" class="d-block small">Kāpēc izslēgti?</a> }@if (stat.Notice != null) { <div class="small text-muted">@stat.Notice</div> }</td>
                                <td>@stat.Read</td>
                                <td>@stat.Qualified</td>
                                <td>@stat.Duplicates</td>
                                <td>@stat.Rejected</td>
                                <td><strong class="text-success">@stat.Added</strong></td>
                                <td>
                                    @if (stat.Error != null)
                                    {
                                        <span class="badge bg-danger">Kļūda</span><div class="small text-danger mt-1">@stat.Error</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">OK</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>Kopā</td>
                            <td>@stats.Sum(x => x.Read)</td>
                            <td>@stats.Sum(x => x.Qualified)</td>
                            <td>@stats.Sum(x => x.Duplicates)</td>
                            <td>@stats.Sum(x => x.Rejected)</td>
                            <td>@stats.Sum(x => x.Added)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="card-footer text-muted small">
                “Atbilstoši” ietver arī jau zināmus projektus. “Dublikāti” ietver visus jau saglabātos URL neatkarīgi no vērtējuma.
                Statistika attiecas uz pēdējo meklēšanu šajā pārlūka sesijā.
            </div>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="text-muted">Visi ieraksti</div>
                    <h3>@ViewBag.TotalCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="text-muted">Jāpārskata</div>
                    <h3>@ViewBag.ReviewCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="text-muted">Apstiprināti</div>
                    <h3 class="text-success">
                        @ViewBag.QualifiedCount
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="text-muted">Noraidīti</div>
                    <h3 class="text-danger">
                        @ViewBag.RejectedCount
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="mb-3">Projektu filtrēšana</h5>

            <form method="get"
                  asp-action="Index"
                  class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label">Meklēt</label>

                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="ASP.NET, website, redesign..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Statuss</label>

                    <select name="status" class="form-select">
                        <option value="">Visi statusi</option>
                        <option value="New" selected="@(status == "New")">New</option>
                        <option value="NeedsReview" selected="@(status == "NeedsReview")">NeedsReview</option>
                        <option value="Qualified" selected="@(status == "Qualified")">Qualified</option>
                        <option value="Rejected" selected="@(status == "Rejected")">Rejected</option>
                        <option value="Contacted" selected="@(status == "Contacted")">Uzrunāti (Contacted)</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Piedāvājuma veids</label>
                    <select name="kind" class="form-select">
                        <option value="">Visi veidi</option>
                        <option value="project" selected="@(kind == "project")">Klientu pasūtījumi / citi ieraksti</option>
                        <option value="contract" selected="@(kind == "contract")">Līgumdarbi / nepilna slodze</option>
                        <option value="procurement" selected="@(kind == "procurement")">Iepirkumi</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Pieteikšanās izmaksas</label>
                    <select name="access" class="form-select">
                        <option value="all" selected="@(access == "all")">Visi, arī vēsturiskie</option>
                        <option value="free" selected="@(access == "free")">Bez priekšapmaksas / bezmaksas limits</option>
                        <option value="paid" selected="@(access == "paid")">Jāmaksā pirms darba</option>
                        <option value="unknown" selected="@(access == "unknown")">Piekļuve jāpārbauda</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Avots</label>

                    <select name="source" class="form-select">
                        <option value="">Visi avoti</option>

                        @foreach (var item in sources)
                        {
                            <option value="@item"
                                    selected="@(source == item)">
                                @item
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Publicēts</label>

                    <select name="age" class="form-select">
                        <option value="">Jebkurā laikā</option>
                        <option value="7" selected="@(age == "7")">
                            Pēdējās 7 dienās
                        </option>
                        <option value="30" selected="@(age == "30")">
                            Pēdējās 30 dienās
                        </option>
                        <option value="unknown" selected="@(age == "unknown")">
                            Datums nav zināms
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Kārtošana</label>

                    <select name="sort" class="form-select">
                        <option value="actionable" selected="@(sort == "actionable")">Ieteicamie klienti vispirms</option>
                        <option value="solo" selected="@(sort == "solo")">Solo piemērotība vispirms</option>
                        <option value="score" selected="@(sort == "score")">
                            Augstākā prioritāte
                        </option>
                        <option value="score_asc" selected="@(sort == "score_asc")">
                            Zemākā prioritāte
                        </option>
                        <option value="newest" selected="@(sort == "newest")">
                            Jaunākie pievienotie
                        </option>
                        <option value="oldest" selected="@(sort == "oldest")">
                            Vecākie pievienotie
                        </option>
                        <option value="published" selected="@(sort == "published")">
                            Jaunākie publicētie
                        </option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">IUB budžets</label>
                    <select name="budget" class="form-select">
                        <option value="">Visi budžeti</option>
                        <option value="under5000" selected="@(budget == "under5000")">Līdz 5 000 €</option>
                        <option value="5000to20000" selected="@(budget == "5000to20000")">5 000–20 000 €</option>
                        <option value="over20000" selected="@(budget == "over20000")">Virs 20 000 €</option>
                        <option value="unknown" selected="@(budget == "unknown")">Budžets nav zināms</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">IUB termiņš</label>
                    <select name="deadline" class="form-select">
                        <option value="">Visi termiņi</option>
                        <option value="open" selected="@(deadline == "open")">Vēl atvērts</option>
                        <option value="expired" selected="@(deadline == "expired")">Termiņš beidzies</option>
                        <option value="unknown" selected="@(deadline == "unknown")">Termiņš nav zināms</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Solo piemērotība</label>
                    <select name="soloFit" class="form-select">
                        <option value="">Visi projekti</option>
                        <option value="possible" selected="@(soloFit == "possible")">Iespējams piemērots</option>
                        <option value="review" selected="@(soloFit == "review")">Jāpārbauda</option>
                        <option value="low" selected="@(soloFit == "low")">Zema solo piemērotība</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Uzrunāšanas lietderība</label>
                    <select name="actionable" class="form-select">
                        <option value="">Visi projekti</option>
                        <option value="recommended" selected="@(actionable == "recommended")">Ieteicamie klienti</option>
                        <option value="review" selected="@(actionable == "review")">Jāpārbauda</option>
                        <option value="skip" selected="@(actionable == "skip")">Nav ieteicams</option>
                    </select>
                </div>

                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button type="submit"
                            class="btn btn-primary">
                        Filtrēt
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Notīrīt
                    </a>

                    <a asp-controller="Leads"
                       asp-action="TestQualification"
                       class="btn btn-outline-dark">
                        🧪 Testēt vērtēšanu
                    </a>

                </div>

            </form>
        </div>
    </div>

    <div class="alert alert-light border">
        <strong>Kā lasīt vērtējumus:</strong>
        Pasūtījuma ticamība rāda klienta pieprasījuma pazīmes,
        prasmju atbilstība — projekta saistību ar tavām tehnoloģijām.
        Tie ir algoritmiski punkti, nevis varbūtības.
        <div class="small text-muted mt-1">
            Jaunā uzrunāšanas lietderība ņem vērā prioritāti, solo piemērotību, statusu, publicēšanas datumu un iespējamus valodas šķēršļus. Tas nav garantēts pasūtījums.
            Solo piemērotība ir orientējošs novērtējums pēc sludinājuma apraksta, nevis garantija par darba apjomu vai iepirkuma prasībām.
        </div>
        <div class="small text-muted mt-1">
            Prioritāte ir datubāzē saglabātais vērtējums, pēc kura kārto sarakstu.
            Pasūtījuma un prasmju rādītāji tiek aprēķināti ar algoritmu 2.3.
            Ja prioritāte atšķiras no pašreizējā aprēķina, nospied “Pārvērtēt projektus”.
            Statuss rāda saglabāto izvērtēšanas lēmumu.
        </div>
    </div>

    <div class="mb-3">
        <div class="d-flex gap-2 flex-wrap" aria-label="Pieteikšanās piekļuves skati">
            <a asp-action="Index" asp-route-access="free" class="btn @(access == "free" ? "btn-primary" : "btn-outline-primary")">Bez priekšapmaksas (@ViewBag.FreeCount)</a>
            <a asp-action="Index" asp-route-access="paid" class="btn @(access == "paid" ? "btn-secondary" : "btn-outline-secondary")">Maksas avotu ieraksti (@ViewBag.PaidCount)</a>
            <a asp-action="Index" asp-route-access="unknown" class="btn @(access == "unknown" ? "btn-secondary" : "btn-outline-secondary")">Piekļuve jāpārbauda (@ViewBag.UnknownCount)</a>
            <a asp-action="Index" asp-route-access="all" class="btn @(access == "all" ? "btn-secondary" : "btn-outline-secondary")">Visi saglabātie (@ViewBag.TotalCount)</a>
        </div>
        <div class="small text-muted mt-2">Skatu skaitļi un augšējās statusu kartītes aptver visu datubāzi. Pārslēdzot skatu, pārējie filtri tiek notīrīti. Nekas netiek dzēsts; melnraksti un uzrunāšanas vēsture saglabājas.</div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white py-3
            d-flex justify-content-between">
            <h5 class="mb-0">@(access switch {
                "free" => "Piedāvājumi bez priekšapmaksas",
                "paid" => "Maksas avotu ieraksti",
                "unknown" => "Ieraksti ar nepārbaudītu piekļuvi",
                _ => "Visi saglabātie projekti"
            })</h5>

            <span class="text-muted">
                Atrasti: @leads.Count
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-striped
                table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Projekts</th>
                        <th>Avots</th>
                        <th>Pasūtījuma ticamība</th>
                        <th>Prasmju atbilstība</th>
                        <th>Prioritāte</th>
                        <th>Solo piemērotība</th>
                        <th>Uzrunāšana</th>
                        <th>Publicēts</th>
                        <th>Statuss</th>
                        <th>Darbības</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var lead in leads)
                    {
                        var evaluation = qualificationService.EvaluateV2(
                            lead.CompanyName ?? "", lead.Description ?? "", lead.SourceType);
                        var solo = SoloFitService.Evaluate(lead);
                        var action = ActionabilityService.Evaluate(lead);
                        var sourceAccess = SourceAccessService.Evaluate(lead);

                        string color = lead.Status switch
                        {
                            "Qualified" => "success",
                            "Contacted" => "primary",
                            "Rejected" => "danger",
                            "NeedsReview" => "warning",
                            _ => "secondary"
                        };

                        string host = "Manual";

                        if (Uri.TryCreate(
                            lead.SourceUrl,
                            UriKind.Absolute,
                            out var uri))
                        {
                            host = uri.Host.Replace("www.", "");
                        }

                        <tr>
                            <td style="max-width:400px;
                                overflow-wrap:anywhere;">
                                <strong>
                                    @System.Net.WebUtility.HtmlDecode(
                                        lead.CompanyName)
                                </strong>
                                @if (lead.SourceType == JobicyLeadSourceService.ContractType) { <div class="badge bg-primary">Līgumdarbs / nepilna slodze</div> }
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @host
                                </span>
                                <div class="mt-1"><span class="badge bg-@sourceAccess.CssClass">@sourceAccess.Label</span></div>
                                <details class="small mt-1"><summary>Piekļuve</summary>@sourceAccess.Detail</details>
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @(lead.SourceType == JobicyLeadSourceService.ContractType ? "Nav piemērojams" : $"{evaluation.OrderConfidence} / 100")
                                </span>
                                <details class="small text-muted mt-1">
                                    <summary>Pamatojums</summary>
                                    <div class="mt-1" style="min-width:160px; overflow-wrap:anywhere;">
                                        @evaluation.OrderReason
                                    </div>
                                </details>
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @evaluation.SkillMatch / 100
                                </span>
                                <details class="small text-muted mt-1">
                                    <summary>Pamatojums</summary>
                                    <div class="mt-1" style="min-width:160px; overflow-wrap:anywhere;">
                                        @evaluation.SkillReason
                                    </div>
                                </details>
                            </td>

                            <td>
                                <strong class="text-nowrap">@lead.AILeadScore / 100</strong>
                                @if (lead.AILeadScore != evaluation.Score)
                                {
                                    <div class="small text-warning-emphasis mt-1">
                                        Jāpārvērtē: jaunais @evaluation.Score / 100
                                    </div>
                                }
                            </td>


                            <td>
                                <span class="badge bg-@solo.CssClass">@solo.Level</span>
                                <div class="small text-muted mt-1">@solo.Complexity</div>
                            </td>

                            <td>
                                <span class="badge bg-@action.CssClass">@action.Label</span>
                                <details class="small text-muted mt-1">
                                    <summary>Pamatojums</summary>
                                    <div>@action.Explanation</div>
                                    @if (action.ExclusionReasons.Count > 0)
                                    {
                                        <div class="fw-semibold mt-2">Kāpēc nav ieteikuma:</div>
                                        <ul class="ps-3 mb-1">
                                            @foreach (var reason in action.ExclusionReasons)
                                            {
                                                <li>@reason.Label — @reason.Detail</li>
                                            }
                                        </ul>
                                    }
                                    @foreach (var note in action.Notes)
                                    {
                                        <div>• @note</div>
                                    }
                                </details>
                            </td>

                            <td>
                                @if (lead.PublishedAt.HasValue)
                                {
                                    @(lead.PublishedAt.Value.ToLocalTime().ToString("dd.MM.yyyy"))
                                }
                                else
                                {
                                    <span class="text-muted">Nav zināms</span>
                                }
                            </td>


                            <td>
                                <span class="badge bg-@color">
                                    @(lead.Status == "Contacted" ? "Uzrunāts" : lead.Status)
                                </span>
                                @if (lead.LastContactedAt.HasValue)
                                {
                                    <div class="small text-muted mt-1" title="Reģistrētā uzrunāšana">
                                        @(lead.LastContactedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                    </div>
                                }
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@lead.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Apskatīt →
                                </a>
                            </td>
                        </tr>
                    }

                    @if (!leads.Any())
                    {
                        <tr>
                            <td colspan="10"
                                class="text-center text-muted py-4">
                                @if (access == "free" && (int)ViewBag.FreeCount == 0)
                                {
                                    <strong>Vēl nav saglabātu piedāvājumu ar pieteikšanos bez priekšapmaksas.</strong>
                                    <div class="mt-2">Vecie maksas un nepārbaudīto avotu ieraksti nav pazuduši — tie pieejami augstāk norādītajos skatos. Ja meklēšanā pievienoti 0 projekti, jaunajā skatā nebūs jaunu piedāvājumu.</div>
                                    <a asp-action="Sources" class="btn btn-outline-primary mt-2">Apskatīt meklēšanas avotus</a>
                                }
                                else
                                {
                                    <span>Šajā piekļuves skatā nav projektu, kas atbilst izvēlētajiem filtriem.</span>
                                    <a asp-action="Index" asp-route-access="@access">Notīrīt pārējos filtrus</a>
                                }
                                @if (actionable == "recommended")
                                {
                                    <div class="mt-2">
                                        <a asp-action="RecommendationDiagnostics">Skatīt visu projektu ieteikumu diagnostiku</a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
